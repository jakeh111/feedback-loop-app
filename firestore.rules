
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Tracks can be read by anyone, but only created, updated, or deleted
    // by the authenticated user who owns them.
    match /tracks/{trackId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Comments can be read by anyone and created by anyone (for guest commenting).
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        // Comments are not updatable or deletable in this app version
        allow update, delete: if false;
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
