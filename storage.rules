rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Users can read and write to any file inside their own user-specific folder
    match /{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Make final tracks publicly readable so anyone with the link can play them
    match /{userId}/tracks/{trackId} {
      allow read;
    }
  }
}
