rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow public read access on final track files
    match /tracks/{userId}/{allPaths=**} {
      allow read;
    }

    // Allow authenticated users to write to their own temp folder for uploads
    match /{userId}/temp/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
