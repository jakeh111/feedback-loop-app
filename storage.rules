rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read and write to their own temp folder.
    match /{userId}/temp/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow public read access to the final tracks.
    match /{userId}/tracks/{allPaths=**} {
        allow read;
    }
  }
}
