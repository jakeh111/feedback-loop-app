rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Grant access to a user's own folder.
    // The client-side upload will have request.auth populated.
    // The server-side Admin SDK will have request.auth == null.
    match /{userId}/{allPaths=**} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || request.auth == null;
    }
  }
}
