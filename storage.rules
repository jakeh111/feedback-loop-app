rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for final tracks
    match /tracks/{userId}/{allPaths=**} {
      allow read;
      // Allow writes only by the track owner.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Temporary files for uploads
    match /temp/{userId}/{filename} {
      // Allow the user to write to their own temp directory
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Allow the server (authenticated via Admin SDK) to read and delete temp files
      allow get, delete: if request.auth == null;
    }
  }
}
