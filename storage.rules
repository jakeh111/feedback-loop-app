rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Match any file in the 'tracks' folder
    match /tracks/{userId}/{allPaths=**} {
      allow read; // Public read access
    }

    // Match files in the 'temp' folder for uploads
    // Users can only write to their own user-id subfolder.
    match /temp/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
