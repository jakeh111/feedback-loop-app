rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Match any file path that starts with a user's ID.
    // The {userId} is a wildcard that captures that part of the path.
    match /{userId}/{allPaths=**} {
      // Allow read and write access only if the request is from an
      // authenticated user AND their UID matches the folder name.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
