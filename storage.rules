rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Client-side rule: Users can read and write files within their own user-specific folder.
    // This allows them to upload the initial temporary file.
    match /{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Server-side rule: Allow the backend admin service to read and write anywhere.
    // The Admin SDK authenticates with privileges that result in `request.auth` being null.
    // This rule is necessary for the server action to read the temporary file and write the final track.
    allow read, write: if request.auth == null;
  }
}
